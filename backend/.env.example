# Configuration Google OAuth2 pour Gmail API
# 
# Pour obtenir ces credentials:
# 1. Allez sur https://console.cloud.google.com/
# 2. Créez un nouveau projet ou sélectionnez un projet existant
# 3. Activez Gmail API dans "API et services" > "Bibliothèque"
# 4. Créez des identifiants OAuth 2.0 dans "API et services" > "Identifiants"
# 5. Configurez l'écran de consentement OAuth
# 6. Ajoutez les URI de redirection autorisées :
#    - http://localhost:3000/oauth2callback
#    - http://localhost:3000/oauth2callback.html
#    - Votre URL de production si applicable
# 7. Téléchargez le fichier JSON des credentials
# 8. Copiez les valeurs ci-dessous

GOOGLE_CLIENT_ID=votre_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback.html

# Pour la production, utilisez votre domaine:
# GOOGLE_REDIRECT_URI=https://votre-domaine.com/oauth2callback.html
